{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Intel显卡：开始训练",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "python": "${workspaceFolder}/.venv-intel/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Intel显卡：断点续训",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "python": "${workspaceFolder}/.venv-intel/Scripts/python.exe",
      "args": ["--resume"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
